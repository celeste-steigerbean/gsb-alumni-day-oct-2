# Pooled Postgres connection string.
# Vercel Postgres and Neon both inject POSTGRES_URL automatically when the
# store is linked. Set it by hand only for local development.
POSTGRES_URL="postgres://user:password@host/db?sslmode=require"

# Password for the dashboard at /board/admin. Yours alone.
ADMIN_PASSWORD="change-me"

# Room passcode for the submit screen and the projected board.
# Defaults to GSB26 with nothing set, so you can leave this out entirely.
# Attendees never type it: the QR code carries it as ?code=GSB26.
# Set it to "open" to remove the gate.
# ROOM_PASSCODE="GSB26"
